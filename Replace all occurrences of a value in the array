#include <stdio.h>

int main() {
    int arr[6] = {5, 10, 5, 20, 5, 30};
    int oldValue, newValue;

    printf("Enter value to replace: ");
    scanf("%d", &oldValue);

    printf("Enter new value: ");
    scanf("%d", &newValue);

    for (int i = 0; i < 6; i++) {
        if (arr[i] == oldValue) {
            arr[i] = newValue;
        }
    }

    printf("Updated array:\n");
    for (int i = 0; i < 6; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
