#include <stdio.h>

int main() {
    int M, N, K, i;

    printf("Enter the value of M: ");
    scanf("%d", &M);

    printf("Enter the value of N: ");
    scanf("%d", &N);

    printf("Enter the value of K: ");
    scanf("%d", &K);

    for (i = M; i <= N; i = i + (K + 1)) {
        printf("%d ", i);
    }

    return 0;
}
