#include <stdio.h>

int main() {
    int a, b, i, j;
    int isComposite;

    printf("Enter value of a: ");
    scanf("%d", &a);

    printf("Enter value of b: ");
    scanf("%d", &b);

    printf("Composite numbers between %d and %d are:\n", a, b);

    for (i = a; i <= b; i++) {

        if (i <= 3)   /* 1, 2, 3 are not composite */
            continue;

        isComposite = 0;

        for (j = 2; j <= i / 2; j++) {
            if (i % j == 0) {
                isComposite = 1;
                break;
            }
        }

        if (isComposite) {
            printf("%d ", i);
        }
    }

    return 0;
}
