#include <stdio.h>

int main() {
    int a[100], freq[100];
    int n;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    for(int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        freq[i] = -1;   // mark all as unvisited
    }

    for(int i = 0; i < n; i++) {
        int count = 1;
        if(freq[i] != -1)
            continue;

        for(int j = i + 1; j < n; j++) {
            if(a[i] == a[j]) {
                count++;
                freq[j] = 0;   // mark as counted
            }
        }
        freq[i] = count;
    }

    printf("Element  Frequency\n");
    for(int i = 0; i < n; i++) {
        if(freq[i] != 0) {
            printf("%d\t%d\n", a[i], freq[i]);
        }
    }

    return 0;
}
