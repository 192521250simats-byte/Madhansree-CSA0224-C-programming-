#include <stdio.h>

int main() {
    int n, i;
    int count = 0;

    printf("Enter a number: ");
    scanf("%d", &n);

    /* Count factors */
    for (i = 1; i <= n; i++) {
        if (n % i == 0) {
            count++;
        }
    }

    printf("Number of factors of %d = %d\n", n, count);

    return 0;
}
