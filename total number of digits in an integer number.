#include <stdio.h>

int main() {
    int n, count = 0;

    printf("Enter an integer number: ");
    scanf("%d", &n);

    /* Handle the case when number is 0 */
    if (n == 0) {
        count = 1;
    } else {
        while (n != 0) {
            count++;
            n = n / 10;
        }
    }

    printf("Total number of digits = %d\n", count);

    return 0;
}
