#include <stdio.h>

// Function to count occurrences using pointer
int countOccurrences(char *str, char ch)
{
    int count = 0;

    while(*str != '\0')
    {
        if(*str == ch)
        {
            count++;
        }
        str++;  
    }

    return count;
}

int main()
{
    char str[100], ch;
    int result;

    printf("Enter a string: ");
    scanf("%s", str);

    printf("Enter a character to search: ");
    scanf(" %c", &ch);   // space before %c avoids newline issue

    result = countOccurrences(str, ch);

    printf("Character '%c' occurred %d times.\n", ch, result);

    return 0;
}

