#include <stdio.h>

long long factorial(int n)
{
    long long fact = 1;
    int i;

    for(i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

int main()
{
    int number;
    long long result;

    printf("Enter a number: ");
    scanf("%d", &number);

    if(number < 0)
    {
        printf("Factorial is not defined for negative numbers.\n");
    }
    else
    {
        result = factorial(number);
        printf("Factorial of %d = %lld\n", number, result);
    }

    return 0;
}
