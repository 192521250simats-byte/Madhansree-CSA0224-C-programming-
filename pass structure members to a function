#include <stdio.h>

// Define structure
struct Student
{
    int roll;
    char name[50];
    float marks;
};

// Function receiving structure members
void display(int r, char n[], float m)
{
    printf("\nStudent Details:\n");
    printf("Roll No: %d\n", r);
    printf("Name: %s\n", n);
    printf("Marks: %.2f\n", m);
}

int main()
{
    struct Student s;

    printf("Enter Roll No: ");
    scanf("%d", &s.roll);

    printf("Enter Name: ");
    scanf("%s", s.name);

    printf("Enter Marks: ");
    scanf("%f", &s.marks);

    // Passing structure members individually
    display(s.roll, s.name, s.marks);

    return 0;
}
