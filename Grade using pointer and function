#include <stdio.h>

// Function to calculate grade using pointer
void findGrade(int *marks)
{
    if(*marks >= 90)
        printf("Grade: A\n");
    else if(*marks >= 75)
        printf("Grade: B\n");
    else if(*marks >= 60)
        printf("Grade: C\n");
    else if(*marks >= 40)
        printf("Grade: D\n");
    else
        printf("Grade: F\n");
}

int main()
{
    int marks;

    printf("Enter marks: ");
    scanf("%d", &marks);

    findGrade(&marks);   // Passing address (pointer)

    return 0;
}
