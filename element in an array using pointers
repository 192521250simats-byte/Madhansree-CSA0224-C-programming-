#include <stdio.h>

int main() {
    int a[5] = {10, 25, 30, 45, 50};
    int key, found = 0;
    int *p = a;

    printf("Enter element to search: ");
    scanf("%d", &key);

    for(int i = 0; i < 5; i++) {
        if(*(p + i) == key) {
            found = 1;
            break;
        }
    }

    if(found)
        printf("Element found");
    else
        printf("Element not found");

    return 0;
}
