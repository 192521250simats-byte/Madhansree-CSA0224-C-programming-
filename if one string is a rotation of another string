#include <stdio.h>
#include <string.h>

int main() {
    char str1[50], str2[50], temp[100];

    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    // If lengths are not equal, not rotation
    if(strlen(str1) != strlen(str2)) {
        printf("Not a rotation");
        return 0;
    }

    // Concatenate first string with itself
    strcpy(temp, str1);
    strcat(temp, str1);

    // Check if str2 is substring of temp
    if(strstr(temp, str2))
        printf("Strings are rotation of each other");
    else
        printf("Strings are not rotation of each other");

    return 0;
}
