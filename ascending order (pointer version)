#include <stdio.h>

int main() {
    int a[5] = {25, 10, 40, 5, 30};
    int *p = a, temp;

    for(int i = 0; i < 5; i++) {
        for(int j = i + 1; j < 5; j++) {
            if(*(p + i) > *(p + j)) {
                temp = *(p + i);
                *(p + i) = *(p + j);
                *(p + j) = temp;
            }
        }
    }

    for(int i = 0; i < 5; i++) {
        printf("%d ", *(p + i));
    }
    return 0;
}
